# Kuvert – Webserver-Regeln (Apache/Strato). Alles in <IfModule>, damit fehlende Module nichts kaputt machen.
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# www.kuvert.net → kuvert.net (eine Adresse für Suchmaschinen)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.kuvert\.net$ [NC]
  RewriteRule ^ https://kuvert.net%{REQUEST_URI} [R=301,L]

  # Kurze Adresse für die App: /app → app.html
  RewriteRule ^app/$ /app [R=301,L]
  RewriteRule ^app$ app.html [L]
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml
</IfModule>

# Browser-Cache: HTML immer frisch, CSS/JS kurz, Schriften lange
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS werden beim Deployment mit ?v=<Hash> versioniert → dürfen lange im Cache bleiben
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

# Sicherheit
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=15552000" "expr=%{HTTPS} == 'on'"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
